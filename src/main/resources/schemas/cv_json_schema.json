{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CV json schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "full_name": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^[A-Za-zÀ-ž'\\-\\s]+$"
    },
    "email": {
      "type": "string",
      "maxLength": 254,
      "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"
    },
    "phone": {
      "type": "string",
      "minLength": 7,
      "maxLength": 15,
      "pattern": "^\\+?[0-9]{7,15}$"
    },
    "profile": {
      "type": "string",
      "maxLength": 2000
    },
    "education": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "school": {
            "type": "string",
            "maxLength": 200

          },
          "period": {
            "type": ["string", "null"] ,
            "maxLength": 100
          },
          "description": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500
            },
            "minItems": 0
          }
        },
        "required": [
          "school",
          "period",
          "description"
        ]
      }
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "period": {
            "type": ["string", "null"],
            "maxLength": 100
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500
            },
            "minItems": 0
          }
        },
        "required": [
          "title",
          "period",
          "tasks"
        ]
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string","maxLength": 80
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "footer": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200,
        "pattern": ".*Wyrażam zgodę na przetwarzanie moich danych.*$"
      }
    }
  },
  "required": [
    "full_name",
    "email",
    "phone",
    "education",
    "experience",
    "skills",
    "footer"
  ]
}